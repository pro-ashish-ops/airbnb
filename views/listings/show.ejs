<% layout("/layouts/boilerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
            <h3 class="offset-3 mt-2">
                <%= listing.title %>
            </h3>

            <div class="show-cards col-6 offset-3">
                <img src="<%= listing.image.url%>" class="card-img-top show-img" alt="listing_image">
                <div>
                    <i>Owned by <%= listing.owner.username %></i>
                </div>
                <br>
                <div>
                    <%= listing.description %>
                </div>
                <div>
                    &#8377; <%= listing.price %>/night

                </div>
                <div>
                    <%= listing.location %>
                </div>
                <div>
                    <%= listing.country %>
                </div>

            </div>


            <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
                <div class="show-btn mt-2 col-6 offset-3 mb-3"><button class="btn btn-dark edit-btn"><a
                            href="/listings/<%= listing._id %>/edit">Edit</a></button>


                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"
                        onsubmit="return confirmDelete()">
                        <button class="btn btn-dark del-btn">Delete</button>
                    </form>

                </div>
                <% } %>

                    <% if(currUser){ %>
                        <div class="col-8 offset-3">
                            <h4>Write a Review</h4>
                            <form action="/listings/<%= listing._id %>/reviews" method="POST">

                                
                                <div class="mb-3 mt-3">
                                    <label class="form-label" for="rating">Rating</label>
                                <fieldset class="starability-slot">
                                     
                        
                                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                                        checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                                </div>
                                <div>
                                    <label class="form-label" for="comment">Comments</label>
                                    <textarea required novalidate class="form-control needs-validation"
                                        name="review[comment]" id="comment"></textarea>
                                    <div class="invalid-feedback">Please write something</div>
                                </div>
                                <button class="btn btn-dark submit-btn mt-3 mb-3">Submit</button>
                            </form>
                        </div>
                        <% } %>

                            <hr>
                            <div class="row col-8 offset-3">
                                <% if (listing.reviews.length===0) { %>
                                    <div>
                                        <h4>No reviews yet</h4>
                                    </div>
                                    <% } else { %>
                                        <p class="col-8 offset-3"><b>All Reviews</b></p>
                                        <% for (let review of listing.reviews) { %>
                                            <div class="card mb-2 p-0">
                                                <div class="card-body py-1 px-2">
                                                    <h5 class="card-title mt-2">
                                                        <%= review.author.username %>
                                
                                                    </h5>
                                                    <p class="starability-result card-text" data-rating="<%= review.rating %>">
                                                               
                                                            </p>
                                                    <p class="card-text">
                                                        <%= review.comment %>
                                                    </p>
                                                    
                                    
                                                </div>
                                                <form class="mb-2 px-2" method="POST"
                                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                    <button class="btn btn-sm btn-dark">Delete</button>
                                                </form>
                                            </div>
                                            <% } %>
                                                <% } %>
                            </div>

        </div>
    </div>